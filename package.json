{
  "name": "tab-pinner",
  "private": true,
  "version": "0.0.0-development",
  "description": "",
  "scripts": {
    "dev:server": "vite",
    "dev": "vite build --watch --mode=development",
    "build": "vite build",
    "type-check": "tsc --noEmit",
