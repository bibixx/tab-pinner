{
  "name": "tab-pinner",
  "private": true,
  "version": "0.0.0-development",
  "description": "",
  "scripts": {
    "dev:server": "vite",
    "dev": "vite build --watch --mode=development",
    "build": "vite build",
    "type-check": "tsc --noEmit",
    "lint": "eslint ./src",
    "lint-commit": "commitlint --from HEAD~",
    "prepare": "husky",
    "package": "npm run build && rm -f tab-pinner.zip && cd build && zip -qr ../tab-pinner.zip ."
  },
